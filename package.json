{
  "name": "kolmari",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "sld:init": "node scripts/sld.mjs init",
    "sld:baseline": "node scripts/sld.mjs baseline",
    "sld:scan": "node scripts/sld.mjs scan",
    "sld:diff": "node scripts/sld.mjs diff",
    "sld:analyze": "node scripts/sld.mjs analyze",
    "sld:check": "node scripts/sld.mjs check",
    "sld:impact": "node scripts/sld.mjs impact",
    "sld:drift": "node scripts/sld.mjs drift",
    "sld:audit": "node scripts/sld.mjs audit",
    "sld:explain": "node scripts/sld.mjs explain",
    "sld:contract": "node scripts/sld.mjs contract",
    "sld:verify": "node scripts/sld.mjs verify",
    "sld:test": "node --test src/sld/__tests__/*.test.mjs",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.1",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260714.1": true
  }
}
